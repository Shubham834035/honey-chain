# HONEY CHAIN - Environment Configuration
# Smart India Hackathon 2026 - SIH26021

# Application Mode: 'demo' (built-in seeded state + cryptographically verified timeline) or 'production' (Supabase + On-chain RPC)
NEXT_PUBLIC_APP_MODE=demo

# Public App URL (used for QR code resolution)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Blockchain Network Configuration (Optional when in Demo Mode)
# Supported: 'simulated' | 'sepolia' | 'polygon_amoy' | 'local_hardhat'
NEXT_PUBLIC_BLOCKCHAIN_PROVIDER=simulated
BLOCKCHAIN_RPC_URL=
SMART_CONTRACT_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
BLOCKCHAIN_PRIVATE_KEY=

# Supabase Configuration (Optional - Demo mode uses robust local persistent store)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
